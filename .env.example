# ============================================================
# extracText - Variables de entorno (12-factor, factor III)
# Copiar a .env y ajustar segun el entorno: cp .env.example .env
# Los valores por defecto coinciden con docker-compose.yml.
# ============================================================

# --- Comun a todos los servicios ---
# Numero de procesos uvicorn por contenedor (factor VIII: concurrencia).
WEB_CONCURRENCY=2

# --- API Gateway (pdf-extractxt-api) ---
APP_NAME=extracText API Gateway
APP_VERSION=0.1.0
APP_DEBUG=false
INGESTION_URL=http://pdf-extractxt-ingestion:8000
STORAGE_URL=http://pdf-extractxt-storage:8000
STORAGE_TIMEOUT_SECONDS=10
INGESTION_TIMEOUT_SECONDS=45
# Debe coincidir con PDF_MAX_SIZE_MB del extractor para el rechazo temprano 413.
PDF_MAX_SIZE_MB=10

# --- Ingestion (pdf-extractxt-ingestion) ---
EXTRACTOR_URL=http://pdf-extractxt-extractor:8000
STORAGE_URL=http://pdf-extractxt-storage:8000
EXTRACTOR_TIMEOUT_SECONDS=30
STORAGE_TIMEOUT_SECONDS=10

# --- Extractor (pdf-extractxt-extractor) ---
PDF_MAX_SIZE_MB=10

# --- Storage (pdf-extractxt-storage) ---
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=extractext
LIST_DEFAULT_LIMIT=50
LIST_MAX_LIMIT=100
